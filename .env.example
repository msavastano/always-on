# =============================================================================
# Always-On CLS AI Agent Configuration
# Copy this file to .env and fill in your ANTHROPIC_API_KEY
# =============================================================================

# --- Anthropic / Claude Haiku 5.5 ---
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_MODEL=claude-haiku-5-5
WAKE_EFFORT=low
SLEEP_EFFORT=medium
MAX_OUTPUT_TOKENS_WAKE=2048
MAX_OUTPUT_TOKENS_SLEEP=4096

# --- Token Pricing (USD per 1M tokens, Claude Haiku 5.5 defaults <=100k prompt) ---
PRICE_INPUT_PER_M=0.10
PRICE_CACHE_READ_PER_M=0.01
PRICE_CACHE_WRITE_PER_M=0.125
PRICE_OUTPUT_PER_M=0.50
PRICE_ANTHROPIC_WEB_SEARCH_PER_1K=10.0

# --- Web Search & Webpage Fetch Tools ---
# Options: ddg (default, zero-key), brave, tavily, searxng, anthropic, disabled
WEB_SEARCH_PROVIDER=ddg
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
SEARXNG_URL=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_MAX_SNIPPET_CHARS=300
WEB_SEARCH_CACHE_TTL_SECONDS=1800
MAX_WEB_SEARCHES_PER_DAY=50
ALLOW_SEARCH_ON_HEARTBEAT=false
ENABLE_FETCH_WEBPAGE=true
FETCH_WEBPAGE_MAX_CHARS=4000
ANTHROPIC_WEB_SEARCH_MAX_USES=3

# --- Anthropic Native Server-Side Code Execution ---
# Runs Python/Bash inside Anthropic's isolated cloud sandbox (zero access to local host)
ENABLE_CODE_EXECUTION=true
CODE_EXECUTION_TOOL_VERSION=code_execution_20260120
# Keep false so untrusted webhooks/heartbeats cannot spin up code execution sandboxes
ALLOW_CODE_EXECUTION_ON_BACKGROUND=false

# --- Storage & Paths ---
DB_PATH=data/agent.db
INBOX_DIR=data/inbox
NOTES_DIR=data/notes

# --- Local Embeddings (ONNX via FastEmbed, zero LLM tokens) ---
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Outer Event Loop & Sources ---
LOOP_TICK_SECONDS=1.0
DEDUP_COOLDOWN_SECONDS=300
HEARTBEAT_EMIT_SECONDS=60
HEARTBEAT_INTERVAL_SECONDS=3600

# --- Local Salience Gating ---
WAKE_THRESHOLD=0.60
SALIENCE_WEIGHT_NOVELTY=0.45
SALIENCE_WEIGHT_RELEVANCE=0.45
SALIENCE_WEIGHT_TEMPORAL=0.10
TEMPORAL_PRESSURE_ASYMPTOTE=0.65

# --- Fast Working Buffer & Fatigue ---
MAX_WORKING_BUDGET_TOKENS=16000
SLEEP_THRESHOLD=0.85
CRITICAL_SATURATION_THRESHOLD=0.95
IDLE_SLEEP_SECONDS=1800
ACTIVE_CONVERSATION_GRACE_SECONDS=300
FATIGUE_DRIFT_HORIZON_HOURS=24.0

# --- Consolidation Guardrails ---
CHURN_MAX_ARCHIVE_RATIO=0.25
CHURN_MIN_CORE_ITEMS=10

# --- Circuit Breakers & Spend Guardrails ---
MAX_DAILY_USD=1.00
MAX_WAKES_PER_HOUR=30
MAX_STEPS_PER_WAKE=6
SEMANTIC_SPIN_THRESHOLD=0.92
BACKOFF_BASE_SECONDS=60
BACKOFF_MAX_SECONDS=3600

# --- Web Dashboard & API ---
HOST=127.0.0.1
PORT=8420
AGENT_NAME=Aion
# Optional shared secret for POST /api/events/webhook (leave blank for local no-auth)
WEBHOOK_SECRET=

# --- Vercel Deployment Reporting (Push Webhook & Zero-Tunnel API Poller) ---
# Native push webhook secret from Vercel Project/Team Settings -> Webhooks (Pro/Enterprise + tunnel)
VERCEL_WEBHOOK_SECRET=
# Personal Access Token from https://vercel.com/account/tokens (works on Free/Hobby + Pro, zero tunnel)
VERCEL_API_TOKEN=
# Optional Vercel Team ID (e.g. team_...) and comma-separated project filter
VERCEL_TEAM_ID=
VERCEL_PROJECT_FILTER=
# Priority policy: smart (failures & prod=high, previews=normal), failures_only, all_high
VERCEL_PRIORITY_POLICY=smart

# --- Managed Background Watchers (started automatically by `uv run always-on run`) ---
ENABLE_CLAUDE_CODE_WATCHER=false
CLAUDE_CODE_WATCHER_INTERVAL_SECONDS=900
CLAUDE_CODE_WATCHER_PRIORITY=high
GITHUB_TOKEN=

ENABLE_VERCEL_WATCHER=false
VERCEL_WATCHER_INTERVAL_SECONDS=60
VERCEL_WATCHER_TARGET=
